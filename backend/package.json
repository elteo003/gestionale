{
  "name": "gestionale-backend",
  "version": "1.0.0",
  "description": "Backend API per Gestionale Associazione",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/**/*.test.js",
    "migrate": "node scripts/migrate.js",
    "migrate:sql": "node scripts/run-sql-migrations.js",
    "migrate:deploy": "node scripts/run-sql-migrations.js",
    "migrate:v2": "node scripts/migrate_v2.js",
    "migrate:all": "node scripts/migrate.js && node scripts/migrate_v2.js && node scripts/run-sql-migrations.js",
    "create-user": "node scripts/create_admin_user.js",
    "hash:registration-code": "node scripts/hash-elevated-registration-code.js",
    "db:check": "node scripts/db-remote-check.js",
    "db:studio": "drizzle-kit studio",
    "db:pull": "drizzle-kit pull",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "vapid:generate": "node scripts/generate-vapid-keys.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.45.2",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "web-push": "^3.6.7",
    "ws": "^8.21.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "drizzle-kit": "^0.31.10",
    "supertest": "^7.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
