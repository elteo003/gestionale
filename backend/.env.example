# Locale: postgres locale. Render da PC: External Connection String (non Internal).
# Esempio Render: postgresql://user:pass@dpg-xxxxx.oregon-postgres.render.com/gestionale_db
DATABASE_URL=postgresql://user:password@host:5432/dbname

# SSL verso Render (default implicito se host contiene render.com). Disattiva solo per Postgres locale senza TLS.
# DRIZZLE_SSL=false
JWT_SECRET=cambia-questa-stringa-con-uno-secret-lungo-e-casuale
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Codice registrazione elevata (Manager/CDA): solo hash bcrypt, mai la password in chiaro.
# Genera con: npm run hash:registration-code
ELEVATED_REGISTRATION_CODE_HASH=
# Ruolo assegnato se il codice è corretto (es. CDA, Responsabile)
ELEVATED_REGISTRATION_ROLE=CDA

# Web Push (stesso protocollo per browser e Electron). Genera con: npm run vapid:generate
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Bootstrap (solo dev locale, mai in produzione)
# SEED_ADMIN=true
# SEED_ADMIN_EMAIL=admin@gestionale.it
# SEED_ADMIN_PASSWORD=
